<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Tropa"
    Width="1200"
    Height="800"
    MinWidth="600"
    x:DataType="vms:MainWindowViewModel"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <DockPanel>
            <DockPanel Margin="{StaticResource Margin8}" DockPanel.Dock="Top">
                <ContentControl x:Name="conTheme" DockPanel.Dock="Right" />
                <Button
                    x:Name="btnConnection"
                    Margin="{StaticResource MarginLr4}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    ToolTip.Tip="{x:Static resx:ResUI.TbConnectionToggleTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="dotConnected"
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Fill="#2E9D4A"
                            IsVisible="False" />
                        <Ellipse
                            x:Name="dotDisconnected"
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Fill="Gray" />
                        <TextBlock
                            x:Name="txtConnectionState"
                            VerticalAlignment="Center"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtConnectionSummary"
                            MaxWidth="280"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="txtConnectionInfo"
                            MaxWidth="200"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Menu Margin="{StaticResource Margin4}">
                    <MenuItem Header="{x:Static resx:ResUI.menuServers}">
                        <MenuItem
                            x:Name="menuAddServerViaClipboard"
                            Header="{x:Static resx:ResUI.menuAddServerFromClipboard}"
                            InputGesture="Ctrl+V" />
                        <MenuItem
                            x:Name="menuAddServerViaScan"
                            Header="{x:Static resx:ResUI.menuAddServerScanQr}"
                            InputGesture="Ctrl+S" />
                        <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static resx:ResUI.menuAddServerFromFile}" />
                        <Separator />
                        <MenuItem Header="{x:Static resx:ResUI.menuAddServerManual}">
                            <MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                            <MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                            <MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                            <MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                            <Separator />
                            <MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                            <MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                            <MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                            <MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                            <MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                            <MenuItem x:Name="menuAddMasqueServer" Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                            <Separator />
                            <MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                            <MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                        </MenuItem>
                        <MenuItem Header="{x:Static resx:ResUI.menuAddServerAdvanced}">
                            <MenuItem x:Name="menuAddCustomServer" Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                            <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                            <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                            <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{x:Static resx:ResUI.menuSubscriptions}">
                        <MenuItem x:Name="menuSubUpdate" Header="{x:Static resx:ResUI.menuSubUpdateAll}" />
                        <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubUpdateAllViaProxy}" />
                        <MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdateCurrent}" />
                        <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateCurrentViaProxy}" />
                        <Separator />
                        <MenuItem x:Name="menuSubAddNew" Header="{x:Static resx:ResUI.menuSubAddNew}" />
                        <MenuItem x:Name="menuSubSetting" Header="{x:Static resx:ResUI.menuSubManage}" />
                    </MenuItem>

                    <MenuItem Header="{x:Static resx:ResUI.menuSetting}">
                        <MenuItem x:Name="menuOptionSetting" Header="{x:Static resx:ResUI.menuSettingsGeneral}" />
                        <MenuItem x:Name="menuRoutingSetting" Header="{x:Static resx:ResUI.menuSettingsRouting}" />
                        <MenuItem x:Name="menuDNSSetting" Header="{x:Static resx:ResUI.menuSettingsDns}" />
                        <MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuUpdateRuRules}" />
                        <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static resx:ResUI.menuSettingsBackup}" />
                        <Separator />
                        <MenuItem Header="{x:Static resx:ResUI.menuAdvancedSettings}">
                            <MenuItem x:Name="menuFullConfigTemplate" Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                            <MenuItem
                                x:Name="menuGlobalHotkeySetting"
                                Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}"
                                IsVisible="{Binding BlIsWindows}" />
                            <Separator />
                            <MenuItem
                                x:Name="menuRebootAsAdmin"
                                Header="{x:Static resx:ResUI.menuRebootAsAdmin}"
                                IsVisible="{Binding BlIsWindows}" />
                            <MenuItem
                                x:Name="menuSettingsSetUWP"
                                Header="{x:Static resx:ResUI.TbSettingsSetUWP}"
                                IsVisible="{Binding BlIsWindows}" />
                            <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                            <!--  Regional presets other than Russia are hidden in this fork; kept for the existing command bindings.  -->
                            <MenuItem
                                x:Name="menuRegionalPresetsDefault"
                                Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}"
                                IsVisible="False" />
                            <MenuItem
                                x:Name="menuRegionalPresetsIran"
                                Header="{x:Static resx:ResUI.menuRegionalPresetsIran}"
                                IsVisible="False" />
                        </MenuItem>
                    </MenuItem>

                    <MenuItem x:Name="menuHelp" Header="{x:Static resx:ResUI.menuHelp}">
                        <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                        <MenuItem x:Name="menuSetupGuide" Header="{x:Static resx:ResUI.menuSetupGuide}" />
                        <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static resx:ResUI.menuOpenProgramFolder}" />
                        <MenuItem x:Name="menuAbout" Header="{x:Static resx:ResUI.menuAbout}" />
                        <Separator />
                        <MenuItem x:Name="menuCoreWebsites" Header="{x:Static resx:ResUI.menuCoreWebsites}" />
                    </MenuItem>

                    <MenuItem Header="⋮" ToolTip.Tip="{x:Static resx:ResUI.menuMore}">
                        <MenuItem
                            x:Name="menuReload"
                            Header="{x:Static resx:ResUI.menuReload}"
                            InputGesture="F5" />
                        <MenuItem x:Name="menuClose" Header="{x:Static resx:ResUI.menuExit}" />
                    </MenuItem>
                </Menu>

                <Button
                    x:Name="btnNewUpdate"
                    Margin="{StaticResource MarginLr8}"
                    HorizontalAlignment="Left"
                    Content="{x:Static resx:ResUI.menuNewUpdate}"
                    IsVisible="False" />
            </DockPanel>

            <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

            <Grid
                x:Name="gridMain"
                ColumnDefinitions="1*,10,1*"
                IsVisible="False">
                <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                <GridSplitter
                    x:Name="gridSplitter"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch" />
                <DockPanel x:Name="tabDockPanel" Grid.Column="2">
                    <TabStrip
                        x:Name="tabStripH"
                        Margin="{StaticResource MarginLr8}"
                        DockPanel.Dock="Top">
                        <TabStrip.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </TabStrip.ItemsPanel>
                    </TabStrip>
                    <TabStrip
                        x:Name="tabStripV"
                        Margin="{StaticResource MarginLr8}"
                        DockPanel.Dock="Left"
                        IsVisible="False">
                        <TabStrip.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </TabStrip.ItemsPanel>
                    </TabStrip>
                    <ContentControl x:Name="tabContent" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </dialogHost:DialogHost>
</Window>
